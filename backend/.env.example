# .env.example  (commit this, not .env)
FLASK_APP=run.py
FLASK_ENV=development
# healthai-3 occupies :5000 (its backend) and :5050 (its local pgAdmin container), so this app runs on :8000
FLASK_RUN_PORT=8000
# Postgres and Redis run via docker-compose.yml at the repo root, exposed on
# 5433 and 6380 (instead of the defaults) to avoid clashing with a local app.
DATABASE_URL=postgresql://postgre:root@localhost:5433/intake_db
REDIS_URL=redis://localhost:6380/0
SECRET_KEY=
STORAGE_BUCKET=
# Shared ARVI platform endpoint (healthai-3) — backs clinic/doctor search
# and patient intake submission
ARVI_API_URL=http://localhost:5000
ARVI_API_KEY=